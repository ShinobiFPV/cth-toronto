{
  "name": "parkemans-go",
  "version": "1.0.0",
  "private": true,
  "description": "ParkeMans GO! — collect Toronto's 1,513 park signs, and hold its 25 Hoods, by camera",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "install:all": "npm install && npm --prefix web install",
    "import-hoods": "node scripts/import-hoods.js",
    "rollover": "node scripts/rollover.js",
    "invite": "node scripts/make-invite.js",
    "test": "node --test \"test/*.test.js\"",
    "import-parks": "node scripts/import-parks.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@turf/boolean-point-in-polygon": "^7.1.0",
    "@turf/centroid": "^7.1.0",
    "@turf/simplify": "^7.1.0",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.5.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "heic-convert": "^2.1.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
