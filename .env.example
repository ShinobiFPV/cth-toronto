# Park-E-Mans GO! — server configuration.
# On the Pi this lives at /home/shinobi/cth/.env and is read by the systemd unit.
# Never commit the real file.

# ── Required in production ───────────────────────────────────────────────────
# Sessions are signed with this. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CTH_JWT_SECRET=

# ── Paths ────────────────────────────────────────────────────────────────────
# Put these on external storage if you have it — a season of drone photos will
# grind an SD card.
CTH_DB=/srv/cth/cth.sqlite
CTH_MEDIA=/srv/cth/media

# ── Network ──────────────────────────────────────────────────────────────────
# Taken on shinobi: 8091 Site Editor, 8092 shintech-forms, 8093 MedFam. Also spoken
# for elsewhere in ShinTech: 8090, 8094 (imq2 HUD), 8095 (shinlink bridge). 8096 is this.
CTH_PORT=8096
CTH_HOST=0.0.0.0
# Behind the Cloudflare Tunnel the browser sees https, so the session cookie is
# Secure. Set false only if you are testing over plain http on the LAN.
CTH_COOKIE_SECURE=true

# ── Game levers (spec §10) ───────────────────────────────────────────────────
# Defaults shown. Change these only between seasons, and tell everybody first.
# A steal pays the Hood's difficulty score times this. At 2 the ceiling is exactly
# 100, which is what a steal paid when it was a flat rate.
#CTH_STEAL_MULTIPLIER=2
#CTH_REINFORCE_POINTS=25
# Fallback difficulty for a Hood with no score of its own. Real scores are 5-50 and
# come from scripts/lib/difficulty.js.
#CTH_BASE_UNCLAIMED_VALUE=25
#CTH_ESCALATION_STEP=25
# Cap the escalation of never-conquered Hoods. Unset = uncapped, so an untouched
# Hood reaches 100 in Season 4 — exactly the value of a steal, which is the point.
#CTH_ESCALATION_CAP=75
#CTH_REINFORCE_GATE_HOURS=72
#CTH_STEAL_COOLDOWN_HOURS=12
# Conquering an unclaimed Hood closes its neighbours to that player for this long —
# the anti-drone lever. 0 disables it entirely.
#CTH_ADJACENT_CONQUER_COOLDOWN_HOURS=6
# Per-player, per-season ceiling on reinforce points. 0 = uncapped. The lever to
# pull if grinding four adjacent Hoods turns out to beat playing the game.
#CTH_REINFORCE_SEASON_CAP=0

# ── Parks, editions and the week ─────────────────────────────────────────────
# Park points per player per Hood per period. Past it a park still prints its card and
# pays XP, worth 0 points and no item. 0 = uncapped. week | season.
#CTH_PARK_HOOD_CAP=300
#CTH_PARK_CAP_PERIOD=week
# The edition table, in percent of one draw. Steel is whatever remains.
#CTH_EDITION_HOLOGRAM_PCT=2
#CTH_EDITION_GOLD_PCT=12
# Every weekly cap (cars, parks, items) counts in weeks starting 00:00 in CTH_TZ on this
# day (MO..SU). CTH_CAR_WEEK_START is the old name and still works.
#CTH_WEEK_START=MO

# ── Items ────────────────────────────────────────────────────────────────────
# Gold and Hologram pulls grant items, only when the card scored points. The weekly cap
# decides whether Fortify is an event or a tax — the first lever to revisit. 0 = uncapped.
#CTH_ITEM_WEEKLY_CAP=4
#CTH_ITEMS_PER_GOLD=1
#CTH_ITEMS_PER_HOLOGRAM=3
# Relative weights for which item a grant is.
#CTH_ITEM_WEIGHT_FORTIFY=10
#CTH_ITEM_WEIGHT_RECON=20
#CTH_ITEM_WEIGHT_CROWBAR=15
#CTH_ITEM_WEIGHT_SPRINT=20
#CTH_ITEM_WEIGHT_TUNEUP=15
#CTH_ITEM_WEIGHT_CLOVER=20
#CTH_CLOVER_HOURS=6
#CTH_CLOVER_MULTIPLIER=2
# How long a steal that hits a Fortify shuts that attacker out of that Hood.
#CTH_FORTIFY_COOLDOWN_HOURS=1

# ── XP ───────────────────────────────────────────────────────────────────────
# No knobs here on purpose. XP is derived from the claims ledger and the schedule lives
# in server/lib/xp.js, because changing it retroactively rewrites everybody's level —
# which should be a code change with a commit message, not an env var flipped at 2am.

# ── Car cards ────────────────────────────────────────────────────────────────
# Snap a car, the server asks Claude what it is, and prints a card for your binder.
# Required for car cards to work at all — without it every car collection returns
# IDENTIFY_UNAVAILABLE and nothing is written. Never commit the real key.
#CTH_ANTHROPIC_API_KEY=
#CTH_IDENTIFY_ENABLED=true
#CTH_IDENTIFY_MODEL=claude-opus-5
#CTH_IDENTIFY_TIMEOUT_MS=45000
# Below this the player is asked for a better angle rather than handed a guess.
#CTH_IDENTIFY_MIN_CONFIDENCE=0.5
# 5 points a car, at most 100 a week per player. Past the cap a car still mints and
# pays XP. The week is CTH_WEEK_START, above.
#CTH_CAR_POINTS=5
#CTH_CAR_WEEKLY_CAP=100
# XP by edition. Every car card is at least Steel.
#CTH_CAR_XP_STEEL=25
#CTH_CAR_XP_GOLD=75
#CTH_CAR_XP_HOLOGRAM=250
# XP for snapping a car you already have this season, once per car per week. 0 turns a
# repeat into ALREADY_COLLECTED with nothing minted.
#CTH_CAR_REPEAT_XP=0
# Blur licence plates in what the app serves. The original, kept behind the login for
# disputes, is not touched.
#CTH_CAR_BLUR_PLATES=true

# ── Disputes ─────────────────────────────────────────────────────────────────
# Anonymous-facing rate limits. Login and registration are the only endpoints a
# stranger can reach, and argon2 makes each attempt cost real CPU.
#CTH_LOGIN_MAX_ATTEMPTS=10
#CTH_LOGIN_WINDOW_MINUTES=15
#CTH_REGISTER_MAX_ATTEMPTS=10
#CTH_REGISTER_WINDOW_MINUTES=60

#CTH_FLAG_THRESHOLD=2
# Refuse flags from the player who just lost the Hood, so a grudge pair cannot
# revert at will. Off by default — the displaced holder is also the person most
# likely to notice a bogus claim.
#CTH_FLAG_EXCLUDE_DISPLACED=false

# ── Scavenger Blitz ──────────────────────────────────────────────────────────
# Three hunts at a time; abandoning one closes abandoning for 6h, because it is a reroll.
#CTH_HUNT_ACTIVE_LIMIT=3
#CTH_HUNT_ABANDON_COOLDOWN_HOURS=6
# 10 points a finished hunt, at most 200 a season, paid into the season it finishes in.
#CTH_HUNT_POINTS=10
#CTH_HUNT_SEASON_POINTS_CAP=200
# Hunt items skip the weekly item cap; instead only this many hunts a week score.
# Past it a hunt pays XP only — no points, no items. 0 = every hunt scores.
#CTH_HUNT_WEEKLY_SCORING_LIMIT=3
#CTH_HUNT_ITEMS=3
#CTH_HUNT_XP_PARK=80
#CTH_HUNT_XP_STREET=240
# A street hunt's mix of common and uncommon cars.
#CTH_HUNT_COMMON=3
#CTH_HUNT_UNCOMMON=2
# Park hunt photos stay with the player unless this is on.
#CTH_HUNT_PARK_PHOTOS_PUBLIC=false
# The street target list. Versioned; active hunts keep the labels they started with.
#CTH_HUNT_VEHICLES=server/data/hunt-vehicles.json

# ── Location ─────────────────────────────────────────────────────────────────
# Find a Park runs on the phone; the server never sees a position. These only tune the list.
#CTH_NEARBY_PARK_COUNT=5
#CTH_NEARBY_ACCURACY_WARN_M=200

# ── Sound ────────────────────────────────────────────────────────────────────
# Where the admin's swapped-in sounds live. Deploy never touches it. Defaults to an audio
# folder beside CTH_MEDIA — /srv/cth/audio on the Pi.
#CTH_AUDIO_DIR=/srv/cth/audio
#CTH_AUDIO_MAX_UPLOAD_MB=20
#CTH_AUDIO_MAX_DURATION_S=8
#CTH_AUDIO_MAX_MUSIC_DURATION_S=180
# Swaps are transcoded with these. The Pi has both.
#CTH_FFMPEG=ffmpeg
#CTH_FFPROBE=ffprobe

# ── Uploads ──────────────────────────────────────────────────────────────────
#CTH_MAX_UPLOAD_MB=60
# Convert HEIC server-side when sharp cannot decode it. Set false to reject HEIC
# outright with a "switch to Most Compatible" message instead.
#CTH_HEIC_SERVER_FALLBACK=true
# Read EXIF and show it read-only on the photo detail page. The server never acts
# on it either way.
#CTH_READ_EXIF=true

# ── Backups ──────────────────────────────────────────────────────────────────
#CTH_BACKUP_DIR=/srv/backups/cth
#CTH_BACKUP_KEEP_DAYS=30
