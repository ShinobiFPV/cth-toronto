[Unit]
Description=Capture the Hood: Toronto
After=network.target

[Service]
Type=simple
User=shinobi
WorkingDirectory=/home/shinobi/cth
Environment=NODE_ENV=production
EnvironmentFile=/home/shinobi/cth/.env
ExecStart=/usr/bin/node /home/shinobi/cth/server/index.js
Restart=always
RestartSec=5

# The database and the media library. ProtectHome below is read-only, so the data
# directory MUST live outside /home — /srv/cth is created once by hand, see SETUP.md.
# Put it on external storage if you ever have some: a season of drone photos will
# grind an SD card.
ReadWritePaths=/srv/cth

# Nothing here needs more than its own directory and the network. ReadWritePaths wins
# over ProtectHome for the paths it names, which is what lets scripts/import-hoods.js
# write web/public while the rest of /home stays read-only to this unit.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/shinobi/cth

[Install]
WantedBy=multi-user.target
