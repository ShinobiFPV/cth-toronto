[Unit]
Description=Capture the Hood: Toronto
After=network.target

[Service]
Type=simple
User=shinobi
WorkingDirectory=/home/shinobi/cth
Environment=NODE_ENV=production
EnvironmentFile=/home/shinobi/cth/.env
ExecStart=/usr/bin/node /home/shinobi/cth/server/index.js
Restart=always
RestartSec=5

# The DB and the media library live under /srv/cth — put that on external storage if
# you have it. A season of drone photos will grind an SD card.
ReadWritePaths=/srv/cth
StateDirectory=cth

# Nothing here needs more than its own directory and the network.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/shinobi/cth

[Install]
WantedBy=multi-user.target
